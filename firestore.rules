rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserOrgId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().organizationId
        : 'org_' + request.auth.uid;
    }

    function isSameOrg(orgId) {
      return isAuthenticated() && (orgId == getUserOrgId() || orgId == 'org_' + request.auth.uid);
    }

    // Users Collection: Users can read and update profiles within their organization
    match /users/{userId} {
      allow read: if isOwner(userId) || isSameOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && (isOwner(userId) || isSameOrg(request.resource.data.organizationId));
      allow update: if isAuthenticated() && (isOwner(userId) || isSameOrg(resource.data.organizationId));
      allow delete: if isOwner(userId);
    }

    // Organizations Collection: Users can access their organization document
    match /organizations/{orgId} {
      allow read: if isSameOrg(orgId);
      allow create: if isAuthenticated() && (orgId == 'org_' + request.auth.uid || isSameOrg(orgId));
      allow update, delete: if isSameOrg(orgId);
    }

    // Businesses Collection: Strict organization isolation
    match /businesses/{businessId} {
      allow read: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow update: if isAuthenticated() 
        && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid)
        && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
    }

    // Activities Collection: Strict organization isolation
    match /activities/{activityId} {
      allow read: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow update: if isAuthenticated() 
        && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid)
        && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
    }

    // KPIs Collection: Strict organization isolation
    match /kpis/{kpiId} {
      allow read: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow update: if isAuthenticated() 
        && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid)
        && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
    }

    // Sales Targets Collection: Strict organization isolation
    match /sales_targets/{targetId} {
      allow read: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow update: if isAuthenticated() 
        && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid)
        && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
    }

    // Achievement Entries Collection: Strict organization isolation
    match /achievement_entries/{achievementId} {
      allow read: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow update: if isAuthenticated() 
        && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid)
        && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
    }

    // Team Reviews Collection: Strict organization isolation
    match /team_reviews/{reviewId} {
      allow read: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow update: if isAuthenticated() 
        && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid)
        && (request.resource.data.organizationId == getUserOrgId() || request.resource.data.organizationId == 'org_' + request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.organizationId == getUserOrgId() || resource.data.organizationId == 'org_' + request.auth.uid);
    }

    // Deny access to all other document paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


