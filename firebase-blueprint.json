{
  "entities": {
    "users": {
      "title": "users",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "monthlyTarget": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["organizationId", "name", "email"]
    },
    "organizations": {
      "title": "organizations",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "monthlyTeamTarget": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "businesses": {
      "title": "businesses",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "companyName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" },
        "industry": { "type": "string" },
        "status": { "type": "string" },
        "dealValue": { "type": "number" },
        "expectedClosureDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["organizationId", "companyName"]
    },
    "activities": {
      "title": "activities",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "businessId": { "type": "string" },
        "type": { "type": "string" },
        "notes": { "type": "string" },
        "activityDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["organizationId", "type", "notes"]
    },
    "kpis": {
      "title": "kpis",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string", "enum": ["Currency", "Number", "Percentage", "Units", "Custom"] },
        "kpiType": { "type": "string", "enum": ["system", "custom"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["organizationId", "name", "unit", "active"]
    },
    "sales_targets": {
      "title": "sales_targets",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "salespersonUid": { "type": "string" },
        "salespersonName": { "type": "string" },
        "kpiId": { "type": "string" },
        "kpiName": { "type": "string" },
        "period": { "type": "string" },
        "targetValue": { "type": "number" },
        "managerComment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["organizationId", "salespersonUid", "salespersonName", "kpiId", "kpiName", "period", "targetValue"]
    },
    "achievement_entries": {
      "title": "achievement_entries",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "salespersonUid": { "type": "string" },
        "salespersonName": { "type": "string" },
        "kpiId": { "type": "string" },
        "kpiName": { "type": "string" },
        "value": { "type": "number" },
        "date": { "type": "string" },
        "customerClient": { "type": "string" },
        "product": { "type": "string" },
        "supportingReference": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["organizationId", "salespersonUid", "salespersonName", "kpiId", "kpiName", "value", "date"]
    },
    "marketing_channels": {
      "title": "marketing_channels",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "purpose": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["organizationId", "name", "category", "active"]
    },
    "marketing_sops": {
      "title": "marketing_sops",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "channelId": { "type": "string" },
        "activity": { "type": "string" },
        "frequency": { "type": "string" },
        "target": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["organizationId", "channelId", "activity", "frequency", "target", "active"]
    },
    "marketing_activities": {
      "title": "marketing_activities",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "channelId": { "type": "string" },
        "sopId": { "type": "string" },
        "date": { "type": "string" },
        "activity": { "type": "string" },
        "target": { "type": "number" },
        "actual": { "type": "number" },
        "result": { "type": "string" },
        "note": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["organizationId", "channelId", "sopId", "date", "activity", "target", "actual", "createdBy"]
    },
    "marketing_insights": {
      "title": "marketing_insights",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "channelId": { "type": "string" },
        "period": { "type": "string" },
        "decision": { "type": "string" },
        "reason": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["organizationId", "channelId", "period", "decision", "reason", "createdBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile collection"
    },
    "/organizations/{orgId}": {
      "schema": "organizations",
      "description": "Organization collection"
    },
    "/businesses/{businessId}": {
      "schema": "businesses",
      "description": "Business records collection"
    },
    "/activities/{activityId}": {
      "schema": "activities",
      "description": "Activity log collection"
    },
    "/kpis/{kpiId}": {
      "schema": "kpis",
      "description": "KPI library definitions"
    },
    "/sales_targets/{targetId}": {
      "schema": "sales_targets",
      "description": "Sales salesperson target allocations"
    },
    "/achievement_entries/{achievementId}": {
      "schema": "achievement_entries",
      "description": "Manual sales accomplishment logs"
    },
    "/marketing_channels/{channelId}": {
      "schema": "marketing_channels",
      "description": "Marketing Channels collection"
    },
    "/marketing_sops/{sopId}": {
      "schema": "marketing_sops",
      "description": "Marketing SOPs checklist"
    },
    "/marketing_activities/{activityId}": {
      "schema": "marketing_activities",
      "description": "Logged execution activities"
    },
    "/marketing_insights/{insightId}": {
      "schema": "marketing_insights",
      "description": "Marketing optimization insights"
    }
  }
}
